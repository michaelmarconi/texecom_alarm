#!/usr/bin/env bashio
# ==============================================================================
# Take down the S6 supervision tree when texecom_alarm fails
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================

declare APP_EXIT_CODE=${1}

if [[ "${APP_EXIT_CODE}" -ne 0 ]] && [[ "${APP_EXIT_CODE}" -ne 256 ]]; then
  bashio::log.error "Texecom Alarm stopped unexpectedly (exit code ${APP_EXIT_CODE}). Scroll up for the Python error — Supervisor will show this add-on as error until it is started again."
  echo "${APP_EXIT_CODE}" > /run/s6-linux-init-container-results/exitcode
  exec /run/s6/basedir/bin/halt
fi

bashio::log.info "Texecom Alarm service closed cleanly; s6 may restart it."
